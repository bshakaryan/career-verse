# Server only. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EVALUATION_MODEL=gpt-5.4-mini
# Production persistence; apply supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Explicitly opt into filesystem storage ONLY for local development.
ALLOW_LOCAL_STORAGE=true
# Maximum AI requests across all guests per UTC day.
AI_DAILY_REQUEST_LIMIT=250
