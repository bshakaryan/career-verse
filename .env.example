# ShopFlow server only. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Pro report text review, called only when the user asks for analysis.
OPENAI_REPORT_MODEL=gpt-5.4-mini

# Legacy PM server only; not used by the ShopFlow simulation.
OPENAI_EVALUATION_MODEL=gpt-5.4-mini
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALLOW_LOCAL_STORAGE=true
AI_DAILY_REQUEST_LIMIT=250
